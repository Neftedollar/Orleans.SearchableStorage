<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <SearchableStoragePackageVersion Condition="'$(SearchableStoragePackageVersion)' == ''">0.0.0-local</SearchableStoragePackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Orleans.SearchableStorage" Version="$(SearchableStoragePackageVersion)" />
  </ItemGroup>
</Project>
