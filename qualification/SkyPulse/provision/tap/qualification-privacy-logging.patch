diff --git a/cmd/tap/privacy_logging.go b/cmd/tap/privacy_logging.go
new file mode 100644
index 0000000000000000000000000000000000000000..a0cbe2da72a6d5fc18b02029915449b6cf50ddcd
--- /dev/null
+++ b/cmd/tap/privacy_logging.go
@@ -0,0 +1,265 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"log"
+	"log/slog"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/bluesky-social/indigo/atproto/syntax"
+	"github.com/bluesky-social/indigo/cmd/tap/models"
+	"github.com/labstack/echo/v4"
+	"gorm.io/gorm"
+)
+
+const (
+	resyncErrorFailed   = "resync_failed"
+	resyncErrorCanceled = "canceled"
+	resyncErrorDeadline = "deadline_exceeded"
+	resyncErrorClaim    = "claim_lost"
+)
+
+// newOperationalLogger is the single production logging boundary. Messages in
+// this binary are fixed source literals. ReplaceAttr prevents values supplied by
+// the relay, PDS, DID documents, HTTP clients, or parsers from being rendered by
+// slog, including when an upstream dependency logs them directly.
+func newOperationalLogger(writer io.Writer, level slog.Level) *slog.Logger {
+	return slog.New(slog.NewJSONHandler(writer, &slog.HandlerOptions{
+		Level:       level,
+		ReplaceAttr: redactOperationalLogAttribute,
+	}))
+}
+
+// installOperationalLogger also silences the legacy standard-library logger.
+// Several HTTP/WebSocket dependencies use it directly for errors and, when
+// verbose transport diagnostics are enabled, headers. Those unstructured calls
+// cannot pass through the attribute policy below.
+func installOperationalLogger(logger *slog.Logger) {
+	slog.SetDefault(logger)
+	// slog.SetDefault rewires the standard logger, so discard it afterwards.
+	log.SetOutput(io.Discard)
+}
+
+func redactOperationalLogAttribute(_ []string, attr slog.Attr) slog.Attr {
+	key := strings.ToLower(attr.Key)
+	switch key {
+	case slog.TimeKey:
+		if attr.Value.Kind() == slog.KindTime {
+			return attr
+		}
+		return slog.Attr{}
+	case slog.LevelKey, slog.MessageKey:
+		// These values are generated by slog and fixed source literals in the
+		// reviewed binary, respectively.
+		return attr
+	case "error", "err", "recover":
+		return slog.String(attr.Key, "redacted")
+	case "url", "relayurl":
+		return sanitizedURLAttribute(attr)
+	case "ident":
+		// TAP uses the firehose URL as the parallel scheduler identity.
+		return sanitizedURLAttribute(attr)
+	case "system":
+		return closedStringAttribute(attr, "tap", "parallel-scheduler", "events")
+	case "component":
+		return closedStringAttribute(attr,
+			"crawler", "event_manager", "firehose", "outbox", "repo_manager",
+			"resyncer", "server", "webhook_client")
+	case "subsystem":
+		return closedStringAttribute(attr, "RobustHTTPClient")
+	case "route":
+		return closedStringAttribute(attr,
+			"unmatched", "/health", "/channel", "/repos/add", "/repos/remove",
+			"/resolve/:did", "/info/:did", "/stats/repo-count",
+			"/stats/record-count", "/stats/outbox-buffer",
+			"/stats/resync-buffer", "/stats/cursors")
+	case "did":
+		return validatedStringAttribute(attr, func(raw string) bool {
+			_, err := syntax.ParseDID(raw)
+			return err == nil
+		})
+	case "rev", "eventrev", "currentrev":
+		return validatedStringAttribute(attr, func(raw string) bool {
+			_, err := syntax.ParseTID(raw)
+			return err == nil
+		})
+	case "cid", "prevdata", "computed":
+		return validatedStringAttribute(attr, func(raw string) bool {
+			_, err := syntax.ParseCID(raw)
+			return err == nil
+		})
+	case "rkey":
+		return validatedStringAttribute(attr, func(raw string) bool {
+			_, err := syntax.ParseRecordKey(raw)
+			return err == nil
+		})
+	case "path":
+		return validatedStringAttribute(attr, validRecordPath)
+	case "collection":
+		return closedStringAttribute(attr,
+			collectionActorProfile, collectionFeedLike, collectionFeedPost,
+			collectionFeedRepost, collectionGraphFollow)
+	case "action":
+		return closedStringAttribute(attr, "create", "update", "delete")
+	case "status":
+		if isNumericLogValue(attr.Value) {
+			return attr
+		}
+		return closedStringAttribute(attr,
+			string(models.AccountStatusActive), string(models.AccountStatusDeactivated),
+			string(models.AccountStatusTakendown), string(models.AccountStatusSuspended),
+			string(models.AccountStatusDeleted))
+	}
+
+	// Unknown strings and arbitrary objects fail closed. Counters, durations and
+	// booleans cannot carry user text and remain useful operationally.
+	if isNumericLogValue(attr.Value) {
+		return attr
+	}
+	return slog.Attr{}
+}
+
+func operationalString(value slog.Value) (string, bool) {
+	switch value.Kind() {
+	case slog.KindString:
+		return value.String(), true
+	case slog.KindAny:
+		return fmt.Sprint(value.Any()), true
+	default:
+		return "", false
+	}
+}
+
+func closedStringAttribute(attr slog.Attr, allowed ...string) slog.Attr {
+	raw, ok := operationalString(attr.Value)
+	if !ok {
+		return slog.Attr{}
+	}
+	for _, candidate := range allowed {
+		if raw == candidate {
+			return slog.String(attr.Key, raw)
+		}
+	}
+	return slog.Attr{}
+}
+
+func validatedStringAttribute(attr slog.Attr, validate func(string) bool) slog.Attr {
+	raw, ok := operationalString(attr.Value)
+	if !ok || !validate(raw) {
+		return slog.Attr{}
+	}
+	return slog.String(attr.Key, raw)
+}
+
+func sanitizedURLAttribute(attr slog.Attr) slog.Attr {
+	raw, ok := operationalString(attr.Value)
+	if !ok {
+		return slog.Attr{}
+	}
+	return slog.String(attr.Key, safeURLForLog(raw))
+}
+
+func isNumericLogValue(value slog.Value) bool {
+	switch value.Kind() {
+	case slog.KindBool, slog.KindDuration, slog.KindFloat64, slog.KindInt64, slog.KindUint64:
+		return true
+	default:
+		return false
+	}
+}
+
+func validRecordPath(raw string) bool {
+	collection, rkey, ok := strings.Cut(raw, "/")
+	if !ok || strings.Contains(rkey, "/") {
+		return false
+	}
+	if _, err := syntax.ParseNSID(collection); err != nil {
+		return false
+	}
+	if _, err := syntax.ParseRecordKey(rkey); err != nil {
+		return false
+	}
+	return true
+}
+
+func safeURLForLog(raw string) string {
+	if len(raw) > 4096 {
+		return "redacted"
+	}
+	parsed, err := url.Parse(raw)
+	if err != nil || parsed.Host == "" {
+		return "redacted"
+	}
+	switch strings.ToLower(parsed.Scheme) {
+	case "http", "https", "ws", "wss":
+	default:
+		return "redacted"
+	}
+	parsed.User = nil
+	parsed.RawQuery = ""
+	parsed.ForceQuery = false
+	parsed.Fragment = ""
+	return parsed.String()
+}
+
+// safeAccessLogger deliberately records only server-owned route templates and
+// numeric measurements. Raw paths, query strings, headers, bodies, credentials,
+// remote addresses, and handler errors never enter the access log.
+func safeAccessLogger(logger *slog.Logger) echo.MiddlewareFunc {
+	return func(next echo.HandlerFunc) echo.HandlerFunc {
+		return func(c echo.Context) error {
+			started := time.Now()
+			err := next(c)
+			status := c.Response().Status
+			if status == 0 {
+				status = 200
+			}
+			if err != nil {
+				var httpError *echo.HTTPError
+				if errors.As(err, &httpError) {
+					status = httpError.Code
+				} else {
+					status = 500
+				}
+			}
+			route := c.Path()
+			if route == "" {
+				route = "unmatched"
+			}
+			logger.Info("http request",
+				"route", route,
+				"status", status,
+				"latency_ms", time.Since(started).Milliseconds(),
+				"bytes_in", c.Request().ContentLength,
+				"bytes_out", c.Response().Size)
+			return err
+		}
+	}
+}
+
+func closedResyncErrorCode(err error) string {
+	switch {
+	case err == nil:
+		return ""
+	case errors.Is(err, context.Canceled):
+		return resyncErrorCanceled
+	case errors.Is(err, context.DeadlineExceeded):
+		return resyncErrorDeadline
+	case errors.Is(err, errResyncClaimLost):
+		return resyncErrorClaim
+	default:
+		return resyncErrorFailed
+	}
+}
+
+func scrubPersistedRepoErrors(tx *gorm.DB) error {
+	closed := []string{resyncErrorFailed, resyncErrorCanceled, resyncErrorDeadline, resyncErrorClaim}
+	return tx.Model(&models.Repo{}).
+		Where("error_msg <> '' AND error_msg NOT IN ?", closed).
+		Update("error_msg", resyncErrorFailed).Error
+}
