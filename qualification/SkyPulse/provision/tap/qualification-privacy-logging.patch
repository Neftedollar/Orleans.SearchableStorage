@@ -0,0 +1,163 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"log"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/bluesky-social/indigo/cmd/tap/models"
+	"github.com/labstack/echo/v4"
+	"github.com/stretchr/testify/require"
+)
+
+func TestOperationalLoggerRedactsSourceControlledValuesAtDebugLevel(t *testing.T) {
+	secret := "SOURCE-CONTROLLED-SECRET"
+	var output bytes.Buffer
+	logger := newOperationalLogger(&output, slog.LevelDebug)
+
+	logger.Debug("fixed diagnostic",
+		"error", errors.New(secret),
+		"err", errors.New(secret),
+		"handle", secret+".example",
+		"body", secret,
+		"content", secret,
+		"query", secret,
+		"record", secret,
+		"unexpected", secret,
+		"action", secret,
+		"collection", "source."+secret+".value",
+		"status", secret,
+		"reason", errors.New(secret),
+		"time", secret,
+		"uri", "/info/"+secret+"?token="+secret,
+		"url", "https://operator:"+secret+"@relay.example/xrpc?token="+secret+"#"+secret,
+		"ident", "wss://operator:"+secret+"@relay.example/xrpc?cursor="+secret,
+		slog.Group("upstream", "handle", secret, "error", errors.New(secret)))
+
+	logged := output.String()
+	require.NotContains(t, logged, secret)
+	require.Contains(t, logged, `"error":"redacted"`)
+	require.Contains(t, logged, `"err":"redacted"`)
+	require.Contains(t, logged, "https://relay.example/xrpc")
+	require.Contains(t, logged, "wss://relay.example/xrpc")
+}
+
+func TestOperationalLoggerRetainsOnlyValidatedMetadataIdentifiers(t *testing.T) {
+	const recordCID = "bafyreie5cvv4h45feadgeuwhbcutmh6t2ceseocckahdoe6uat64zmz454"
+	var output bytes.Buffer
+	logger := newOperationalLogger(&output, slog.LevelDebug)
+	logger.Debug("fixed diagnostic",
+		"did", testActorDID,
+		"eventRev", testRevA,
+		"path", collectionFeedPost+"/post-a",
+		"cid", recordCID,
+		"action", "create",
+		"collection", collectionFeedPost)
+
+	logged := output.String()
+	require.Contains(t, logged, testActorDID)
+	require.Contains(t, logged, testRevA)
+	require.Contains(t, logged, collectionFeedPost+"/post-a")
+	require.Contains(t, logged, recordCID)
+}
+
+func TestInstallOperationalLoggerSilencesLegacyLogger(t *testing.T) {
+	secret := "LEGACY-LOGGER-SECRET"
+	previousWriter := log.Writer()
+	previousLogger := slog.Default()
+	t.Cleanup(func() {
+		log.SetOutput(previousWriter)
+		slog.SetDefault(previousLogger)
+	})
+
+	var legacyOutput bytes.Buffer
+	log.SetOutput(&legacyOutput)
+	var structuredOutput bytes.Buffer
+	installOperationalLogger(newOperationalLogger(&structuredOutput, slog.LevelDebug))
+	log.Printf("upstream error: %s", secret)
+	slog.Error("fixed diagnostic", "error", errors.New(secret))
+
+	require.Empty(t, legacyOutput.String())
+	require.NotContains(t, structuredOutput.String(), secret)
+}
+
+func TestSafeAccessLoggerUsesOnlyRouteTemplateAndNumbers(t *testing.T) {
+	secret := "REQUEST-SOURCE-SECRET"
+	var output bytes.Buffer
+	logger := newOperationalLogger(&output, slog.LevelDebug)
+	e := echo.New()
+	e.Use(safeAccessLogger(logger))
+	e.GET("/info/:did", func(c echo.Context) error {
+		return echo.NewHTTPError(http.StatusBadRequest, "handler-"+secret)
+	})
+
+	req := httptest.NewRequest(http.MethodGet, "/info/"+secret+"?token="+secret, strings.NewReader(secret))
+	req.Header.Set("User-Agent", secret)
+	recorder := httptest.NewRecorder()
+	e.ServeHTTP(recorder, req)
+
+	logged := output.String()
+	require.NotContains(t, logged, secret)
+	require.Contains(t, logged, `"route":"/info/:did"`)
+	require.Contains(t, logged, `"status":400`)
+}
+
+func TestIdentityDirectoryNeverResolvesOrLogsHandles(t *testing.T) {
+	directory := newBaseIdentityDirectory(TapConfig{PLCURL: "https://plc.directory"})
+	require.True(t, directory.SkipHandleVerification)
+}
+
+func TestClosedResyncErrorCodesNeverContainDiagnostics(t *testing.T) {
+	secret := errors.New("PDS response includes private source text")
+	tests := []struct {
+		err  error
+		want string
+	}{
+		{nil, ""},
+		{secret, resyncErrorFailed},
+		{context.Canceled, resyncErrorCanceled},
+		{context.DeadlineExceeded, resyncErrorDeadline},
+		{errResyncClaimLost, resyncErrorClaim},
+	}
+	for _, test := range tests {
+		require.Equal(t, test.want, closedResyncErrorCode(test.err))
+		require.NotContains(t, test.want, secret.Error())
+	}
+}
+
+func TestVersionTwoMigrationScrubsPersistentErrorDiagnostics(t *testing.T) {
+	databasePath := filepath.Join(t.TempDir(), "tap.sqlite")
+	db, err := SetupDatabase("sqlite://"+databasePath, 1)
+	require.NoError(t, err)
+	secret := "PERSISTED-UPSTREAM-PDS-MESSAGE"
+	require.NoError(t, db.Create(&models.Repo{
+		Did: testActorDID, State: models.RepoStateError, Status: models.AccountStatusActive,
+		ErrorMsg: secret,
+	}).Error)
+	require.NoError(t, db.Model(&models.MetadataOnlyOverlayState{}).
+		Where("id = ?", 1).
+		Update("version", previousMetadataOnlyOverlayVersion).Error)
+	sqlDB, err := db.DB()
+	require.NoError(t, err)
+	require.NoError(t, sqlDB.Close())
+
+	db, err = SetupDatabase("sqlite://"+databasePath, 1)
+	require.NoError(t, err)
+	var state models.MetadataOnlyOverlayState
+	require.NoError(t, db.First(&state, "id = ?", 1).Error)
+	require.Equal(t, metadataOnlyOverlayVersion, state.Version)
+	var repo models.Repo
+	require.NoError(t, db.First(&repo, "did = ?", testActorDID).Error)
+	require.Equal(t, resyncErrorFailed, repo.ErrorMsg)
+	require.NotContains(t, repo.ErrorMsg, secret)
+	sqlDB, err = db.DB()
+	require.NoError(t, err)
+	require.NoError(t, sqlDB.Close())
+}
