+func validateQualificationStartup(config *TapConfig) error {
+	if config == nil {
+		return errors.New("qualification TAP configuration is required")
+	}
+	if len(config.AdminPassword) > 4096 || strings.TrimSpace(config.AdminPassword) == "" || strings.ContainsAny(config.AdminPassword, "\r\n") {
+		return errors.New("qualification TAP requires a non-empty bounded admin password without line breaks")
+	}
+	if config.DisableAcks || config.WebhookURL != "" {
+		return errors.New("qualification TAP requires WebSocket acknowledgement mode")
+	}
+	if config.FullNetworkMode || strings.TrimSpace(config.SignalCollection) != "" {
+		return errors.New("qualification TAP requires an explicit repository set")
+	}
+	if config.NoReplay {
+		return errors.New("qualification TAP requires source replay")
+	}
+	if len(config.CollectionFilters) != 0 {
+		return errors.New("qualification TAP requires all reviewed metadata collections")
+	}
+	return nil
+}
+
 func NewTap(config TapConfig) (*Tap, error) {
