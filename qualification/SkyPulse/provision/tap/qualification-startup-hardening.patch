+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestValidateQualificationStartup(t *testing.T) {
+	valid := TapConfig{AdminPassword: "qualification-secret"}
+	if err := validateQualificationStartup(&valid); err != nil {
+		t.Fatalf("valid qualification configuration was rejected: %v", err)
+	}
+
+	tests := []struct {
+		name   string
+		config TapConfig
+		want   string
+	}{
+		{name: "missing password", config: TapConfig{}, want: "admin password"},
+		{name: "blank password", config: TapConfig{AdminPassword: "  "}, want: "admin password"},
+		{name: "line break", config: TapConfig{AdminPassword: "secret\nother"}, want: "admin password"},
+		{name: "acks disabled", config: TapConfig{AdminPassword: "secret", DisableAcks: true}, want: "WebSocket acknowledgement"},
+		{name: "webhook", config: TapConfig{AdminPassword: "secret", WebhookURL: "https://example.test/events"}, want: "WebSocket acknowledgement"},
+		{name: "full network", config: TapConfig{AdminPassword: "secret", FullNetworkMode: true}, want: "explicit repository set"},
+		{name: "signal collection", config: TapConfig{AdminPassword: "secret", SignalCollection: "app.bsky.feed.post"}, want: "explicit repository set"},
+		{name: "no replay", config: TapConfig{AdminPassword: "secret", NoReplay: true}, want: "source replay"},
+		{name: "collection subset", config: TapConfig{AdminPassword: "secret", CollectionFilters: []string{"app.bsky.feed.post"}}, want: "all reviewed metadata collections"},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			err := validateQualificationStartup(&test.config)
+			if err == nil || !strings.Contains(err.Error(), test.want) {
+				t.Fatalf("expected an error containing %q, got %v", test.want, err)
+			}
+		})
+	}
+}
+
+func TestNewTapChecksQualificationConfigurationBeforeOpeningDatabase(t *testing.T) {
+	_, err := NewTap(TapConfig{
+		DatabaseURL: "this database URL must never be opened",
+	})
+	if err == nil || !strings.Contains(err.Error(), "admin password") {
+		t.Fatalf("expected startup authentication failure, got %v", err)
+	}
+}
