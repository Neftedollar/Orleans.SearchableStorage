diff --git a/cmd/tap/metadata_sanitizer.go b/cmd/tap/metadata_sanitizer.go
new file mode 100644
index 0000000000000000000000000000000000000000..b49e8c88c15fc1913e0591919345fe1a98371618
--- /dev/null
+++ b/cmd/tap/metadata_sanitizer.go
@@ -0,0 +1,235 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/bluesky-social/indigo/atproto/syntax"
+)
+
+const (
+	metadataStatusValid   = "valid"
+	metadataStatusInvalid = "invalid"
+	invalidCollection     = "invalid"
+	invalidAction         = "invalid"
+
+	collectionFeedPost     = "app.bsky.feed.post"
+	collectionFeedLike     = "app.bsky.feed.like"
+	collectionFeedRepost   = "app.bsky.feed.repost"
+	collectionGraphFollow  = "app.bsky.graph.follow"
+	collectionActorProfile = "app.bsky.actor.profile"
+)
+
+var errResyncClaimLost = errors.New("resync claim is no longer current")
+
+// sanitizeCommitForDurableStorage is the last boundary before a commit may be
+// serialized into ResyncBuffer. It deliberately drops every source record body.
+func sanitizeCommitForDurableStorage(commit *Commit) (*Commit, error) {
+	if commit == nil {
+		return nil, errors.New("commit is nil")
+	}
+	if err := validateDurableDID(commit.Did); err != nil {
+		return nil, err
+	}
+	if err := validateDurableRev(commit.Rev); err != nil {
+		return nil, err
+	}
+
+	sanitized := &Commit{
+		Did:      commit.Did,
+		Rev:      commit.Rev,
+		DataCid:  commit.DataCid,
+		PrevData: commit.PrevData,
+		Ops:      make([]CommitOp, 0, len(commit.Ops)),
+	}
+	for i := range commit.Ops {
+		evt := &RecordEvt{
+			Did:            commit.Did,
+			Rev:            commit.Rev,
+			Collection:     commit.Ops[i].Collection,
+			Rkey:           commit.Ops[i].Rkey,
+			Action:         commit.Ops[i].Action,
+			Record:         commit.Ops[i].Record,
+			Cid:            commit.Ops[i].Cid,
+			MetadataStatus: commit.Ops[i].MetadataStatus,
+			Metadata:       commit.Ops[i].Metadata,
+		}
+		safe, _, err := sanitizeRecordEvent(evt)
+		if err != nil {
+			return nil, fmt.Errorf("sanitize operation %d: %w", i, err)
+		}
+		sanitized.Ops = append(sanitized.Ops, CommitOp{
+			Collection:     safe.Collection,
+			Rkey:           safe.Rkey,
+			Action:         safe.Action,
+			Cid:            safe.Cid,
+			MetadataStatus: safe.MetadataStatus,
+			Metadata:       safe.Metadata,
+		})
+	}
+	return sanitized, nil
+}
+
+// sanitizeRecordEvent creates the only RecordEvt shape permitted in durable
+// outbox storage. The returned boolean controls RepoRecord catalog mutation.
+func sanitizeRecordEvent(evt *RecordEvt) (*RecordEvt, bool, error) {
+	if evt == nil {
+		return nil, false, errors.New("record event is nil")
+	}
+	if err := validateDurableDID(evt.Did); err != nil {
+		return nil, false, err
+	}
+	if err := validateDurableRev(evt.Rev); err != nil {
+		return nil, false, err
+	}
+	if _, err := syntax.ParseRecordKey(evt.Rkey); err != nil {
+		return nil, false, fmt.Errorf("invalid record key: %w", err)
+	}
+
+	safe := &RecordEvt{
+		Live:       evt.Live,
+		Did:        evt.Did,
+		Rev:        evt.Rev,
+		Collection: evt.Collection,
+		Rkey:       evt.Rkey,
+		Action:     evt.Action,
+		Cid:        evt.Cid,
+	}
+
+	if !isMetadataCollection(evt.Collection) {
+		safe.Collection = invalidCollection
+		safe.Rkey = "invalid"
+		safe.Action = invalidAction
+		safe.Cid = ""
+		return safe, false, nil
+	}
+
+	switch evt.Action {
+	case "delete":
+		safe.Cid = ""
+		return safe, true, nil
+	case "create", "update":
+		// Continue below.
+	default:
+		safe.Collection = invalidCollection
+		safe.Rkey = "invalid"
+		safe.Action = invalidAction
+		safe.Cid = ""
+		return safe, false, nil
+	}
+
+	status, metadata := sanitizeMetadata(evt.Collection, evt.Record, evt.MetadataStatus, evt.Metadata)
+	safe.MetadataStatus = status
+	safe.Metadata = metadata
+	return safe, true, nil
+}
+
+func sanitizeMetadata(collection string, record map[string]any, existingStatus string, existing map[string]string) (string, map[string]string) {
+	if existingStatus != "" {
+		if existingStatus == metadataStatusInvalid && len(existing) == 0 {
+			return metadataStatusInvalid, nil
+		}
+		if existingStatus == metadataStatusValid && validateSanitizedMetadata(collection, existing) {
+			return metadataStatusValid, cloneMetadata(existing)
+		}
+		return metadataStatusInvalid, nil
+	}
+
+	switch collection {
+	case collectionActorProfile:
+		return metadataStatusValid, nil
+	case collectionFeedPost:
+		replyValue, hasReply := record["reply"]
+		if !hasReply {
+			return metadataStatusValid, nil
+		}
+		reply, ok := replyValue.(map[string]any)
+		if !ok {
+			return metadataStatusInvalid, nil
+		}
+		parent, ok := reply["parent"].(map[string]any)
+		if !ok {
+			return metadataStatusInvalid, nil
+		}
+		uri, ok := parent["uri"].(string)
+		if !ok || !validRecordATURI(uri) {
+			return metadataStatusInvalid, nil
+		}
+		return metadataStatusValid, map[string]string{"reply_parent_uri": uri}
+	case collectionFeedLike, collectionFeedRepost:
+		subject, ok := record["subject"].(map[string]any)
+		if !ok {
+			return metadataStatusInvalid, nil
+		}
+		uri, ok := subject["uri"].(string)
+		if !ok || !validRecordATURI(uri) {
+			return metadataStatusInvalid, nil
+		}
+		return metadataStatusValid, map[string]string{"subject_uri": uri}
+	case collectionGraphFollow:
+		did, ok := record["subject"].(string)
+		if !ok || validateDurableDID(did) != nil {
+			return metadataStatusInvalid, nil
+		}
+		return metadataStatusValid, map[string]string{"follow_subject_did": did}
+	default:
+		return metadataStatusInvalid, nil
+	}
+}
+
+func validateSanitizedMetadata(collection string, metadata map[string]string) bool {
+	switch collection {
+	case collectionActorProfile:
+		return len(metadata) == 0
+	case collectionFeedPost:
+		if len(metadata) == 0 {
+			return true
+		}
+		return len(metadata) == 1 && validRecordATURI(metadata["reply_parent_uri"])
+	case collectionFeedLike, collectionFeedRepost:
+		return len(metadata) == 1 && validRecordATURI(metadata["subject_uri"])
+	case collectionGraphFollow:
+		return len(metadata) == 1 && validateDurableDID(metadata["follow_subject_did"]) == nil
+	default:
+		return false
+	}
+}
+
+func validRecordATURI(raw string) bool {
+	uri, err := syntax.ParseATURI(raw)
+	return err == nil && uri.Authority().IsDID() && uri.Collection() != "" && uri.RecordKey() != ""
+}
+
+func isMetadataCollection(collection string) bool {
+	switch collection {
+	case collectionFeedPost, collectionFeedLike, collectionFeedRepost, collectionGraphFollow, collectionActorProfile:
+		return true
+	default:
+		return false
+	}
+}
+
+func validateDurableDID(raw string) error {
+	if _, err := syntax.ParseDID(raw); err != nil {
+		return fmt.Errorf("invalid DID: %w", err)
+	}
+	return nil
+}
+
+func validateDurableRev(raw string) error {
+	if _, err := syntax.ParseTID(raw); err != nil {
+		return fmt.Errorf("invalid repository revision: %w", err)
+	}
+	return nil
+}
+
+func cloneMetadata(source map[string]string) map[string]string {
+	if len(source) == 0 {
+		return nil
+	}
+	result := make(map[string]string, len(source))
+	for key, value := range source {
+		result[key] = value
+	}
+	return result
+}
