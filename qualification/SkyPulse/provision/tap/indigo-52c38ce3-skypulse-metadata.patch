+func initializeMetadataOnlyOverlay(db *gorm.DB) error {
+	return db.Transaction(func(tx *gorm.DB) error {
+		var state models.MetadataOnlyOverlayState
+		err := tx.First(&state, "id = ?", 1).Error
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			var outboxCount int64
+			if err := tx.Model(&models.OutboxBuffer{}).Count(&outboxCount).Error; err != nil {
+				return err
+			}
+			var resyncCount int64
+			if err := tx.Model(&models.ResyncBuffer{}).Count(&resyncCount).Error; err != nil {
+				return err
+			}
+			if outboxCount != 0 || resyncCount != 0 {
+				return fmt.Errorf("metadata-only TAP overlay refuses legacy durable buffers: outbox=%d resync=%d", outboxCount, resyncCount)
+			}
+			state = models.MetadataOnlyOverlayState{ID: 1, Version: metadataOnlyOverlayVersion}
+			if err := tx.Create(&state).Error; err != nil {
+				return err
+			}
+		} else if err != nil {
+			return err
+		} else if state.Version != metadataOnlyOverlayVersion {
+			return fmt.Errorf("unsupported metadata-only TAP overlay durable version %d", state.Version)
+		}
+
+		var maximumOutboxID uint64
+		if err := tx.Model(&models.OutboxBuffer{}).Select("COALESCE(MAX(id), 0)").Scan(&maximumOutboxID).Error; err != nil {
+			return err
+		}
+		if maximumOutboxID > state.LastEventID {
+			return fmt.Errorf("metadata-only TAP delivery high-water %d is below durable outbox ID %d", state.LastEventID, maximumOutboxID)
+		}
+		if err := validateDurableMetadataOnlyBuffers(tx); err != nil {
+			return err
+		}
+
+		// Indigo used to retain handles in this column. The overlay never needs
+		// them, so scrub any pre-marker value on every compatible startup.
+		if tx.Migrator().HasColumn(&models.Repo{}, "Handle") {
+			if err := tx.Model(&models.Repo{}).Where("handle <> ''").Update("handle", "").Error; err != nil {
+				return err
+			}
+		}
+		return nil
+	})
+}
+
+func validateDurableMetadataOnlyBuffers(tx *gorm.DB) error {
+	var outboxRows []models.OutboxBuffer
+	if err := tx.FindInBatches(&outboxRows, 500, func(_ *gorm.DB, _ int) error {
+		for i := range outboxRows {
+			if err := validateDurableOutboxRow(&outboxRows[i]); err != nil {
+				return fmt.Errorf("invalid metadata-only outbox row %d: %w", outboxRows[i].ID, err)
+			}
+		}
+		return nil
+	}).Error; err != nil {
+		return err
+	}
+
+	var resyncRows []models.ResyncBuffer
+	if err := tx.FindInBatches(&resyncRows, 500, func(_ *gorm.DB, _ int) error {
+		for i := range resyncRows {
+			var commit Commit
+			if err := decodeExactJSON([]byte(resyncRows[i].Data), &commit); err != nil {
+				return fmt.Errorf("invalid metadata-only resync row %d: %w", resyncRows[i].ID, err)
+			}
+			if commit.Did != resyncRows[i].Did {
+				return fmt.Errorf("invalid metadata-only resync row %d: DID mismatch", resyncRows[i].ID)
+			}
+			safe, err := sanitizeCommitForDurableStorage(&commit)
+			if err != nil {
+				return fmt.Errorf("invalid metadata-only resync row %d: %w", resyncRows[i].ID, err)
+			}
+			if !reflect.DeepEqual(safe, &commit) {
+				return fmt.Errorf("invalid metadata-only resync row %d: noncanonical commit", resyncRows[i].ID)
+			}
+			canonical, err := json.Marshal(safe)
+			if err != nil || !bytes.Equal(canonical, []byte(resyncRows[i].Data)) {
+				return fmt.Errorf("invalid metadata-only resync row %d: noncanonical JSON", resyncRows[i].ID)
+			}
+		}
+		return nil
+	}).Error; err != nil {
+		return err
+	}
+	return nil
+}
+
+func validateDurableOutboxRow(row *models.OutboxBuffer) error {
+	var event MarshallableEvt
+	if err := decodeExactJSON([]byte(row.Data), &event); err != nil {
+		return err
+	}
+	if event.ID != row.ID || event.ID == 0 {
+		return errors.New("delivery ID mismatch")
+	}
+	var canonical []byte
+	var err error
+	switch event.Type {
+	case "record":
+		if event.RecordEvt == nil || event.IdentityEvt != nil || event.RepoSyncEvt != nil {
+			return errors.New("record envelope shape is invalid")
+		}
+		safe, _, sanitizeErr := sanitizeRecordEvent(event.RecordEvt)
+		if sanitizeErr != nil {
+			return sanitizeErr
+		}
+		if !reflect.DeepEqual(safe, event.RecordEvt) {
+			return errors.New("record envelope is not canonical metadata-only data")
+		}
+		if row.Did != event.RecordEvt.Did || row.Live != event.RecordEvt.Live {
+			return errors.New("record durable columns do not match the envelope")
+		}
+		canonical, err = safe.MarshalWithId(event.ID)
+	case "identity":
+		if event.IdentityEvt == nil || event.RecordEvt != nil || event.RepoSyncEvt != nil {
+			return errors.New("identity envelope shape is invalid")
+		}
+		if err := validateIdentityEvent(event.IdentityEvt); err != nil {
+			return err
+		}
+		if row.Did != event.IdentityEvt.Did || !row.Live {
+			return errors.New("identity durable columns do not match the envelope")
+		}
+		canonical, err = event.IdentityEvt.MarshalWithId(event.ID)
+	case "repo_sync":
+		if event.RepoSyncEvt == nil || event.RecordEvt != nil || event.IdentityEvt != nil {
+			return errors.New("repo_sync envelope shape is invalid")
+		}
+		if err := validateDurableDID(event.RepoSyncEvt.Did); err != nil {
+			return err
+		}
+		if err := validateDurableRev(event.RepoSyncEvt.Rev); err != nil {
+			return err
+		}
+		if event.RepoSyncEvt.Status != models.AccountStatusActive || row.Did != event.RepoSyncEvt.Did || !row.Live {
+			return errors.New("repo_sync durable columns do not match the envelope")
+		}
+		canonical, err = event.RepoSyncEvt.MarshalWithId(event.ID)
+	default:
+		return errors.New("unknown outbox event type")
+	}
+	if err != nil {
+		return err
+	}
+	if !bytes.Equal(canonical, []byte(row.Data)) {
+		return errors.New("outbox JSON is not canonical")
+	}
+	return nil
+}
+
+func decodeExactJSON(data []byte, destination any) error {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(destination); err != nil {
+		return err
+	}
+	if err := decoder.Decode(&struct{}{}); !errors.Is(err, io.EOF) {
+		if err == nil {
+			return errors.New("multiple JSON values")
+		}
+		return err
+	}
+	return nil
+}
