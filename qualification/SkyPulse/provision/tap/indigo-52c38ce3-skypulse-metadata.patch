+		Did: testActorDID, Collection: collectionActorProfile, Rkey: "self", Cid: "bafy-unchanged-profile",
+	}).Error)
+
+	// Reactivation must invalidate the old CID catalog because the consumer
+	// purged its projection at the preceding inactive identity barrier.
+	require.NoError(t, fp.ProcessAccount(te.ctx, &comatproto.SyncSubscribeRepos_Account{Did: testActorDID, Active: true, Seq: 2}))
+	var catalogCount int64
+	require.NoError(t, te.db.Model(&models.RepoRecord{}).Where("did = ?", testActorDID).Count(&catalogCount).Error)
+	require.Zero(t, catalogCount)
+
+	r := newTestResyncer(te)
+	claim, found, err := r.claimResyncJob(te.ctx)
+	require.NoError(t, err)
+	require.True(t, found)
+	require.Equal(t, testActorDID, claim.Did)
+
+	require.NoError(t, te.events.AddRecordEvents(te.ctx, []*RecordEvt{{
+		Did: testActorDID, Rev: testRevA, Collection: collectionActorProfile,
+		Rkey: "self", Action: "create", Cid: "bafy-profile", Record: map[string]any{"displayName": "must-not-persist"},
+	}}, false, func(tx *gorm.DB) error { return guardResyncClaim(tx, claim) }))
+
+	buffered := &Commit{Did: testActorDID, Rev: testRevB, PrevData: "bafy-snapshot", DataCid: "bafy-live", Ops: []CommitOp{{
+		Collection: collectionFeedPost, Rkey: "live-post", Action: "create", Cid: "bafy-live-post", Record: map[string]any{"text": "must-not-persist"},
+	}}}
+	require.NoError(t, te.events.addToResyncBuffer(te.ctx, buffered, claim.Token))
+	require.NoError(t, r.completeResyncCutover(te.ctx, claim, testRevA, "bafy-snapshot"))
+	require.NoError(t, r.drainResyncBuffer(te.ctx, claim.Did, claim.Token))
+
+	var rows []models.OutboxBuffer
+	require.NoError(t, te.db.Order("id ASC").Find(&rows).Error)
+	require.Len(t, rows, 4)
+	require.True(t, strings.Contains(rows[0].Data, `"type":"identity"`), rows[0].Data)
+	require.True(t, strings.Contains(rows[1].Data, `"type":"record"`), rows[1].Data)
+	require.True(t, strings.Contains(rows[2].Data, `"type":"repo_sync"`), rows[2].Data)
+	require.True(t, strings.Contains(rows[3].Data, `"type":"record"`), rows[3].Data)
+	require.True(t, rows[0].Live)
+	require.False(t, rows[1].Live)
+	require.True(t, rows[2].Live)
+	require.True(t, rows[3].Live)
+	for _, row := range rows {
+		require.NotContains(t, row.Data, "must-not-persist")
+	}
+}
