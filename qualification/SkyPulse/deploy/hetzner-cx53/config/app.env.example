# Non-secret application/TAP configuration. Copy to ../runtime/app.env.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5080
DOTNET_EnableDiagnostics=0
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning

SkyPulse__Mode=Durable
SkyPulse__Durable__ProfileId=REPLACE_WITH_PROFILE_ID
SkyPulse__Durable__ProfileVersion=1
SkyPulse__Durable__CorpusCap=REPLACE_WITH_POSITIVE_INTEGER
SkyPulse__Durable__ProfilePrefixSha256=REPLACE_WITH_LOWERCASE_64_HEX_PREFIX_SHA256
SkyPulse__Durable__SourceInstanceId=REPLACE_WITH_STABLE_NONZERO_UUID
SkyPulse__Durable__CorpusManifestPath=/var/lib/skypulse/corpus/corpus.manifest.json
SkyPulse__Durable__TapEndpoint=ws://127.0.0.1:2480/channel
SkyPulse__Durable__RoutingManifestPath=/var/lib/skypulse/routes-root/REPLACE_WITH_PROFILE_ID/routing.private.manifest.json
SkyPulse__Durable__ExclusiveRepositoryAdministrationConfirmed=true
SkyPulse__Durable__FullNetworkModeDisabledConfirmed=true
SkyPulse__Durable__AutomaticRepositoryDiscoveryDisabledConfirmed=true

# Optional reviewed monotonic target. Repeat with __1__, __2__, ... for more.
# Never remove an active or pending profile from this catalog after restart.
# SkyPulse__Durable__GrowthProfiles__0__ProfileId=accounts-100k
# SkyPulse__Durable__GrowthProfiles__0__CorpusCap=100000
# SkyPulse__Durable__GrowthProfiles__0__ProfilePrefixSha256=REPLACE_WITH_64_HEX
# SkyPulse__Durable__GrowthProfiles__0__RoutingManifestPath=/var/lib/skypulse/routes-root/accounts-100k/routing.private.manifest.json

SKYPULSE_PG_HOST=skypulse-db.internal
SKYPULSE_PG_PORT=5432
SKYPULSE_PG_DATABASE=skypulse
SKYPULSE_PG_USERNAME=skypulse_app
