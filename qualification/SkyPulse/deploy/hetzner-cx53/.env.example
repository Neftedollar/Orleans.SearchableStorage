# Copy to .env. This file is deliberately non-secret.

DEPLOYMENT_ID=REPLACE_WITH_RELEASE_GIT_SHA
PLATFORM=linux/amd64

# Exact external image identities. Mutable tags and placeholder digests fail preflight.
DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0.302-noble@sha256:REPLACE_WITH_REVIEWED_DIGEST
DOTNET_ASPNET_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0.11-noble@sha256:REPLACE_WITH_REVIEWED_DIGEST
POSTGRES_IMAGE=postgres:17.11-bookworm@sha256:REPLACE_WITH_REVIEWED_DIGEST
CADDY_IMAGE=caddy:2.11.4-alpine@sha256:REPLACE_WITH_REVIEWED_DIGEST

APP_PRIVATE_IP=10.42.0.10
POSTGRES_PRIVATE_IP=10.42.0.20
POSTGRES_PRIVATE_DNS=skypulse-db.internal
APP_PRIVATE_INTERFACE=REPLACE_WITH_APP_HETZNER_PRIVATE_INTERFACE
POSTGRES_PRIVATE_INTERFACE=REPLACE_WITH_POSTGRES_HETZNER_PRIVATE_INTERFACE

# Immutable base runtime identity, duplicated here for backup/restore verification.
EXPECTED_BASE_PROFILE_ID=REPLACE_WITH_PROFILE_ID
EXPECTED_BASE_CORPUS_CAP=REPLACE_WITH_POSITIVE_INTEGER
EXPECTED_SOURCE_INSTANCE_ID=REPLACE_WITH_PERSISTENT_UUID
EXPECTED_ACTIVE_PROFILE_ID=REPLACE_WITH_CURRENT_ACTIVE_PROFILE_ID
EXPECTED_ACTIVE_CORPUS_CAP=REPLACE_WITH_CURRENT_ACTIVE_CORPUS_CAP

# Absolute host paths.
APP_SECRET_DIR=/srv/skypulse/secrets/app
TAP_SECRET_DIR=/srv/skypulse/secrets/tap
POSTGRES_SECRET_DIR=/srv/skypulse/secrets/postgres
PUBLIC_CORPUS_DIR=/srv/skypulse/corpus/active
PRIVATE_ROUTING_ROOT=/srv/skypulse/private-routes
APP_PG_CA_CERT=/srv/skypulse/tls/ca.crt
POSTGRES_TLS_DIR=/srv/skypulse/tls/postgres
POSTGRES_DATA_DIR=/srv/skypulse/postgres/data
POSTGRES_BACKUP_DIR=/srv/skypulse/postgres/backups
CADDY_DATA_DIR=/srv/skypulse/caddy/data
CADDY_CONFIG_DIR=/srv/skypulse/caddy/config

# Optional public proxy. Leave false and use an SSH tunnel for a private calibration.
ENABLE_PUBLIC_PROXY=false
CADDYFILE_PATH=/srv/skypulse/config/Caddyfile
SKYPULSE_PUBLIC_BASE_URL=
SKYPULSE_CURL_CONFIG=
